CREATE TABLE PageEntity (
    id TEXT NOT NULL PRIMARY KEY,
    documentId TEXT NOT NULL,
    orderIndex INTEGER NOT NULL,
    originalImagePath TEXT NOT NULL,
    processedImagePath TEXT NOT NULL,
    corners TEXT,
    filter TEXT NOT NULL DEFAULT 'ORIGINAL',
    ocrText TEXT NOT NULL DEFAULT '',
    width INTEGER NOT NULL DEFAULT 0,
    height INTEGER NOT NULL DEFAULT 0,
    FOREIGN KEY (documentId) REFERENCES DocumentEntity(id) ON DELETE CASCADE
);

CREATE INDEX page_document_idx ON PageEntity(documentId);

selectByDocument:
SELECT * FROM PageEntity WHERE documentId = :documentId ORDER BY orderIndex ASC;

upsert:
INSERT INTO PageEntity(id, documentId, orderIndex, originalImagePath, processedImagePath, corners, filter, ocrText, width, height)
VALUES (:id, :documentId, :orderIndex, :originalImagePath, :processedImagePath, :corners, :filter, :ocrText, :width, :height)
ON CONFLICT(id) DO UPDATE SET
    orderIndex = excluded.orderIndex,
    originalImagePath = excluded.originalImagePath,
    processedImagePath = excluded.processedImagePath,
    corners = excluded.corners,
    filter = excluded.filter,
    ocrText = excluded.ocrText,
    width = excluded.width,
    height = excluded.height;

deleteByDocument:
DELETE FROM PageEntity WHERE documentId = :documentId;

deleteById:
DELETE FROM PageEntity WHERE id = :id;
